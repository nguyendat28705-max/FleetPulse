{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FleetPulse Feature Contract",
  "contract_version": "1.1.0",
  "window_spec": {
    "size_sec": 10,
    "min_samples": 1,
    "ideal_samples": 10
  },
  "feature_order": [
    "tp2_mean",
    "tp2_std",
    "tp2_slope",
    "loaded_ratio",
    "rise_rate",
    "cycle_len_s",
    "oil_temp_mean",
    "oil_temp_max",
    "motor_current_mean",
    "motor_current_p95",
    "delta_pressure"
  ],
  "features": {
    "tp2_mean": {
      "type": "float",
      "unit": "bar",
      "description": "Áp suất trung bình tại đầu ra máy nén trong cửa sổ",
      "source": "TP2 analog sensor",
      "calculation": "mean(TP2)",
      "missing_rule": "fallback 0.0 hoặc baseline mean",
      "range": [-0.5, 15.0]
    },
    "tp2_std": {
      "type": "float",
      "unit": "bar",
      "description": "Độ biến thiên (độ lệch chuẩn mẫu N-1) của áp suất TP2",
      "source": "TP2 analog sensor",
      "calculation": "std(TP2)",
      "missing_rule": "fallback 0.0",
      "range": [0.0, 10.0]
    },
    "tp2_slope": {
      "type": "float",
      "unit": "bar/sample",
      "description": "Độ dốc hồi quy tuyến tính OLS của áp suất TP2",
      "source": "TP2 analog sensor",
      "calculation": "OLS linear regression slope",
      "missing_rule": "fallback 0.0",
      "range": [-5.0, 5.0]
    },
    "loaded_ratio": {
      "type": "float",
      "unit": "ratio",
      "description": "Tỷ lệ thời gian máy nén chạy có tải (COMP == 0)",
      "source": "COMP digital signal",
      "calculation": "count(COMP < 0.5) / N",
      "missing_rule": "fallback 0.0",
      "range": [0.0, 1.0]
    },
    "rise_rate": {
      "type": "float",
      "unit": "bar/sample",
      "description": "Tốc độ tăng áp trung bình trong các pha chạy tải",
      "source": "TP2 analog sensor và COMP digital signal",
      "calculation": "mean(delta_p / delta_t khi COMP == 0)",
      "missing_rule": "fallback max(0.0, tp2_slope)",
      "range": [0.0, 5.0]
    },
    "cycle_len_s": {
      "type": "float",
      "unit": "seconds",
      "description": "Độ dài chu kỳ nén ước tính giữa các lần bật tải",
      "source": "chuyển tiếp trạng thái COMP",
      "calculation": "N / count(transitions)",
      "missing_rule": "fallback N",
      "range": [0.0, 3600.0]
    },
    "oil_temp_mean": {
      "type": "float",
      "unit": "celsius",
      "description": "Nhiệt độ dầu bôi trơn trung bình của máy nén",
      "source": "Oil_temperature sensor",
      "calculation": "mean(Oil_temperature)",
      "missing_rule": "fallback 60.0",
      "range": [0.0, 120.0]
    },
    "oil_temp_max": {
      "type": "float",
      "unit": "celsius",
      "description": "Nhiệt độ dầu bôi trơn cao nhất trong cửa sổ",
      "source": "Oil_temperature sensor",
      "calculation": "max(Oil_temperature)",
      "missing_rule": "fallback 60.0",
      "range": [0.0, 130.0]
    },
    "motor_current_mean": {
      "type": "float",
      "unit": "amperes",
      "description": "Dòng điện động cơ trung bình của máy nén",
      "source": "Motor_current sensor",
      "calculation": "mean(Motor_current)",
      "missing_rule": "fallback 0.0",
      "range": [0.0, 25.0]
    },
    "motor_current_p95": {
      "type": "float",
      "unit": "amperes",
      "description": "Phân vị 95% dòng điện động cơ máy nén",
      "source": "Motor_current sensor",
      "calculation": "percentile_95(Motor_current)",
      "missing_rule": "fallback 0.0",
      "range": [0.0, 30.0]
    },
    "delta_pressure": {
      "type": "float",
      "unit": "bar",
      "description": "Chênh lệch áp suất TP2 (máy nén) và TP3 (bình điều khiển)",
      "source": "TP2 và TP3 sensors",
      "calculation": "mean(TP2) - mean(TP3)",
      "missing_rule": "fallback 0.0",
      "range": [-15.0, 15.0]
    }
  },
  "example_document": {
    "deviceId": "M-017",
    "line": "L1",
    "gatewayId": "GW-03",
    "windowStart": "2026-10-20T08:00:00.000Z",
    "windowSec": 10,
    "n": 10,
    "late": false,
    "feat": {
      "tp2_mean": 1.37,
      "tp2_std": 3.25,
      "tp2_slope": 0.01,
      "loaded_ratio": 0.42,
      "rise_rate": 0.07,
      "cycle_len_s": 38.0,
      "oil_temp_mean": 62.6,
      "oil_temp_max": 65.2,
      "motor_current_mean": 2.05,
      "motor_current_p95": 6.8,
      "delta_pressure": -7.61
    },
    "edge": {
      "cusum_pos": 1.2,
      "alert": false,
      "mode": "normal"
    },
    "shard": 2,
    "ts_chain": {
      "emit_ts": "2026-10-20T08:00:10.005Z",
      "gateway_ts": "2026-10-20T08:00:10.020Z",
      "ingest_ts": "2026-10-20T08:00:10.035Z"
    }
  }
}
