# MongoDB cục bộ (docker compose). Muốn dùng Atlas thì thay bằng chuỗi mongodb+srv://...
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=fleetpulse_dev

# Cổng phía máy host cho docker compose (đổi nếu bị trùng với dịch vụ khác)
MONGO_HOST_PORT=27017
MQTT_HOST_PORT=1883
