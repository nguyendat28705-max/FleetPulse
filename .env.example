# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG FLEETPULSE
# ==============================================================================

# Chế độ chạy MongoDB: 'local' (Docker Replica Set) hoặc 'cloud' (MongoDB Atlas)
MONGODB_MODE=local

# 1. Cấu hình MongoDB Cloud (MongoDB Atlas)
# Thay <username>, <password>, <cluster-url> bằng thông tin thực tế từ Atlas UI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=fleetpulse_dev

# 2. Cấu hình MongoDB Local (Docker Compose Replica Set)
MONGODB_LOCAL_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true

# Cổng dịch vụ phía máy Host
MONGO_HOST_PORT=27017
MQTT_HOST_PORT=1883
MQTT_HOST=localhost

# 3. Cấu hình Predictor Engine: 'baseline' (Rule-Based + Kalman) hoặc 'ai' (ML Model)
PREDICTOR_MODE=baseline
AI_MODEL_PATH=models/fleetpulse_model.joblib

# 4. Cấu hình Sharding
N_SHARDS=4

# 5. Cấu hình Giám sát (Tùy chọn)
METRICS_ENABLED=false
DD_AGENT_HOST=localhost
DD_AGENT_PORT=8125
